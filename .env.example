OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# 配置供应商池时设置此项；未设置时继续使用上面的单供应商配置。
# LLM_PROVIDERS_PATH=config/llm_providers.json
# 供应商池中的 api_key_env 从系统环境或本文件读取，例如：
# LLM_PRIMARY_API_KEY=
# LLM_FALLBACK_1_API_KEY=
LLM_PROVIDER_RETRY_COUNT=1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
LLM_MAX_PROVIDER_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=120
ENABLE_LLM_TRACE=false
LLM_TRACE_LOG_PATH=./runtime/llm_trace.jsonl
SQLITE_DB_PATH=../data/数据入库v_1.1_0722/query_ready_v2/zhangbei_energy_query_ready_v2.sqlite3
DDL_DIRECTORY=../data/数据入库v_1.1_0722/query_ready_v2/ddl
# Compose bind mount source paths; production should use explicit absolute paths.
ENERGY_DB_PATH=../data/数据入库v_1.1_0722/query_ready_v2/zhangbei_energy_query_ready_v2.sqlite3
ENERGY_DDL_PATH=../data/数据入库v_1.1_0722/query_ready_v2/ddl
QUERY_TIMEOUT_SECONDS=10
QUERY_TOTAL_TIMEOUT_SECONDS=240
MAX_RESULT_ROWS=100
MAX_SQL_MODIFICATION_ATTEMPTS=1
MAX_RESULT_REQUERY_ATTEMPTS=1
AUDIT_LOG_PATH=./runtime/query_audit.jsonl
STAGE_TIMING_LOG_PATH=./runtime/stage_timing.jsonl
PLATFORM_DB_PATH=./runtime/platform.sqlite3
ENABLE_QUERY_DIAGNOSTICS=false
# 设置后，规则与评测管理 API 必须携带 X-Admin-Key。
ADMIN_API_KEY=
# 本地开发保持 development；上线部署必须设置 production，并同时提供 ADMIN_API_KEY。
DEPLOYMENT_MODE=development
# Optional read-only key for rules, evaluation history, and run replay.
VIEWER_API_KEY=
# 可选 OTLP HTTP traces 端点，例如 Phoenix 的 http://phoenix:6006/v1/traces。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=resources-agent
CONVERSATION_TTL_SECONDS=900
CONVERSATION_MAX_SESSIONS=1000
