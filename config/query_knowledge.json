  "rules": [
    {
      "id": "citywide_installed_capacity_yoy",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": ["Q2"],
      "scope_tables": [
        "t01_operating_renewable_station_profile",
        "t07_distributed_pv_wind"
      ],
      "required_fields": {
        "t01_operating_renewable_station_profile": ["energy_type", "grid_capacity_mw", "grid_connection_month"],
        "t07_distributed_pv_wind": ["station_type", "installed_capacity_mw", "operation_date"]
      },
      "terms": ["和去年同期比", "新能源装机增长", "装机同比", "装机同比增长"],
      "formula": "同比增量 = 最新有效月份累计装机 - 上年同期累计装机；同比增速 = 同比增量 / 上年同期累计装机 × 100%",
      "content": "装机历史口径使用并网/投运月份作为纳入日期。表01并网容量等同集中式装机，表07按项目类型将分布式光伏、分散式风电纳入对应分类。统计截至日取两表各自最新有效日期中的较早共同月份；分别计算当期及上年同期累计装机，再汇总总量和分类型。不得把当前全量容量直接当作去年同期快照。"
    },
    {
      "id": "distributed_pv_county_growth",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": ["Q8"],
      "scope_tables": ["t07_distributed_pv_wind"],
      "required_fields": {
        "t07_distributed_pv_wind": ["station_type", "installed_capacity_mw", "district_name", "operation_date"]
      },
      "terms": ["分布式光伏哪个县区跑得最快", "分布式光伏发展最快", "分布式光伏新增装机"],
      "formula": "近12个月新增装机 = operation_date > (数据最新有效日期 - 12个月) 且 <= 数据最新有效日期的项目装机容量之和",
      "content": "只筛选 station_type='分布式光伏'。表07记录均为已投运项目，不再追加状态条件。回答必须同时给出各县区累计装机排名和近12个月新增装机排名；“跑得最快”按近12个月新增装机MW最大判定，平行时按累计装机降序。数据最新有效日期取分布式光伏记录的MAX(operation_date)，当前为2024-12-01。待核实区县不进入排名。"
    },
    {
      "id": "distributed_pv_classification",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": ["Q8", "Q10", "Q28"],
      "scope_tables": ["t07_distributed_pv_wind"],
      "required_fields": {
        "t07_distributed_pv_wind": [
          "station_type",
          "station_type_2",
          "installed_capacity_mw",
          "district_name",
          "operation_date"
        ]
      },
      "terms": [
        "分布式光伏",
        "分布式光伏项目",
        "分布式光伏装机",
        "分布式光伏县区排名"
      ],
      "content": "表07中，分布式光伏必须使用项目类型“分布式光伏”精确筛选；项目类型的另一已发布枚举为“分散式风电”。上网方式只描述全额上网、自发自用或余电上网，不用于识别光伏。表07全体记录均为已投运项目，无需追加投运状态条件。装机容量使用规范化 MW 数值，县区使用已发布区县维度。"
    },
    {
      "id": "installed_capacity_from_grid_capacity",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": [
        "Q1",
        "Q7",
        "Q27"
      ],
      "scope_tables": [
        "t01_operating_renewable_station_profile"
      ],
      "required_fields": {
        "t01_operating_renewable_station_profile": [
          "grid_capacity_mw"
        ]
      },
      "terms": [
        "装机容量",
        "总装机",
        "新能源装机",
        "并网容量"
      ],
      "content": "一期已运行集中式新能源电站统计中，用户所称“装机容量”使用 t01_operating_renewable_station_profile.grid_capacity_mw（并网容量）计算；输出时应说明该一期口径。"
    },
    {
      "id": "q24_parent_group_top5_and_central_enterprise_share",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": [
        "Q24"
      ],
      "scope_tables": [
        "t01_operating_renewable_station_profile"
      ],
      "required_fields": {
        "t01_operating_renewable_station_profile": [
          "parent_group",
          "grid_capacity_mw"
        ]
      },
      "terms": [
        "装机最多的5家业主单位",
        "业主单位装机排名",
        "上级集团装机排名",
        "归属上级集团",
        "央企占比"
      ],
      "formula": "央企装机占比 = 已发布10家央企集团的并网容量合计 / 全部归属上级集团并网容量合计 × 100%",
      "content": "Q24仅统计已运行集中式新能源电站。“业主单位”在本题中按归属上级集团解释，装机容量使用规范化并网容量MW。按归属上级集团分组求和，降序取前5。央企名单为：国家能源集团、中国大唐集团、中国广核集团、国家电投集团、中国核工业集团、中国节能环保集团、中国华能集团、中国三峡集团、华润集团、中国华电集团。地方国企为：北京能源集团、河北建投集团、河北交投集团。央企占比分母为全部归属上级集团装机容量合计。空值不按0处理。"
    },
    {
      "id": "county_from_location",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": [
        "Q7",
        "Q8",
        "Q10"
      ],
      "scope_tables": [],
      "terms": [
        "哪个县区",
        "各县区",
        "县区",
        "区县",
        "按县",
        "县域"
      ],
      "content": "当前发布表未单列 county 字段时，必须使用受控上下文中的“行政区派生规则”从项目/站点位置字段以完整行政区名称派生县区。不得向用户追问是否接受按地址汇总；派生为“待核实”的记录不得进入县区排名、占比或增速分母，并须在回答中说明。"
    },
    {
      "id": "q1_citywide_installed_capacity",
      "status": "published",
      "runtime_enabled": true,
      "source_question_ids": [
        "Q1"
      ],
      "scope_tables": [
        "t01_operating_renewable_station_profile",
        "t07_distributed_pv_wind"
      ],
      "required_fields": {
        "t01_operating_renewable_station_profile": [
          "energy_type",
          "grid_capacity_mw"
        ],
        "t07_distributed_pv_wind": [
          "station_type",
          "installed_capacity_mw"
        ]
      },
      "terms": [
        "全市新能源总装机",
        "分类型多少"
      ],
      "formula": "全市新能源总装机 = 表01集中式并网容量 + 表07分布式装机容量；风电 = 表01风电 + 表07分散式风电；光伏 = 表01光伏 + 表07分布式光伏；风光储一体化单列",
      "content": "客户题集 Q1 已确认表01并网容量就是集中式装机容量。当前查询库已将表01 grid_capacity_mw 与表07 installed_capacity_mw 规范化为 REAL 类型的 MW 数值，直接用于 SUM、比较和排序；不得再对这两个规范化字段执行 TRIM、REPLACE 或单位文本清洗。对应 *_raw 原文列仅用于追溯，不参与计算。空值必须排除并形成告警，不得按0处理。查询必须同时返回全市总计和分类型明细；题集标准答案是示意值，不得写入SQL。"
    },
    {
