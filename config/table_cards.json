{
  "version": "2026-07-20-source-truth-audit",
  "table_cards": [
    {
      "table": "t01_operating_renewable_station_profile",
      "dataset": "已运行集中式新能源电站项目画像",
      "description": "已运行集中式风电、光伏电站的并网容量、能源类型、位置、并网时间和配储信息。",
      "aliases": {"新能源装机": "grid_capacity_mw", "并网容量": "grid_capacity_mw", "电站": "station_name", "配储": "storage_capacity_mwh"},
      "metrics": ["并网容量", "配储容量", "电站数量"],
      "dimensions": ["能源类型", "电站类型", "项目位置", "并网时间", "归属上级集团"],
      "important_fields": ["station_name", "energy_type", "station_type", "grid_capacity_mw", "storage_capacity_mwh", "grid_connection_date", "project_location", "parent_group"],
      "data_limitations": ["grid_capacity_mw 和 storage_capacity_mwh 均为文本字段；仅已发布规则允许将并网容量作为一期集中式装机口径。", "不包含分布式项目。"]
    },
    {
      "table": "t01_operating_generation_monthly",
      "dataset": "已运行集中式新能源发电量月度数据",
      "description": "场站、时间周期和指标名称粒度的发电量时间序列。",
      "aliases": {"发电量": "metric_value", "月份": "time_period", "场站": "station_name", "指标": "metric_name"},
      "metrics": ["发电量", "等效利用小时"],
      "dimensions": ["场站", "电站类型", "时间周期", "时间粒度", "指标名称"],
      "important_fields": ["station_name", "station_type", "project_location", "time_period", "time_granularity", "metric_name", "metric_unit", "metric_value"],
      "data_limitations": ["具体指标含义、单位和时间粒度必须以 metric_name、metric_unit、time_granularity 过滤后确认。"]
    },
    {
      "table": "t01_operating_curtailment_monthly",
      "dataset": "已运行集中式新能源限电量月度数据",
