      "aliases": {"限电量": "metric_value", "弃风": "metric_value", "弃光": "metric_value", "月份": "time_period", "场站": "station_name"},
      "metrics": ["限电量"],
      "dimensions": ["场站", "电站类型", "时间周期", "时间粒度", "指标名称"],
