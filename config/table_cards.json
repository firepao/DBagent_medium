      "metrics": ["项目容量", "项目数量", "总投资额"],
      "dimensions": ["项目类型", "建设地点", "当前阶段进展", "预计并网时间", "建设单位"],
      "important_fields": ["project_name", "project_type", "project_capacity_mw", "construction_location", "current_progress", "grid_access_approval", "grid_connection_date", "construction_unit"],
      "data_limitations": ["project_capacity_mw 为文本字段，且源表标题同时包含新能源 MW 与储能 MWh，跨项目类型汇总前须确认口径。", "项目滞后判定规则尚未发布。"]
